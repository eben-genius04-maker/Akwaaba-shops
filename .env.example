# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to GitHub.

# Supabase → Project Settings → Data API → Project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase → Project Settings → API Keys → Publishable key (sb_publishable_...)
# (or the legacy "anon" key). Safe for the browser: the database rules protect data.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# Where the app runs. Local development:
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Root domain WITHOUT protocol. Stores live at <store>.<root domain>
NEXT_PUBLIC_ROOT_DOMAIN=localhost:3000

# Production values (set these in Vercel, not here):
# NEXT_PUBLIC_SITE_URL=https://akwaabashops.com
# NEXT_PUBLIC_ROOT_DOMAIN=akwaabashops.com
# NEXT_PUBLIC_COOKIE_DOMAIN=.akwaabashops.com   (shares login across store subdomains)
# Before your own domain is connected (e.g. on akwaaba-shops.vercel.app), turn shop
# subdomains off so shop links use /s/<shop>:
# NEXT_PUBLIC_STORE_SUBDOMAINS=false

# -----------------------------------------------------------------------------
# SERVER-ONLY SECRETS (Phase 9: Paystack). Never prefix these with NEXT_PUBLIC_.
# -----------------------------------------------------------------------------
# Supabase → Project Settings → API Keys → service_role / Secret key
SUPABASE_SERVICE_ROLE_KEY=

# Encrypts each store's Paystack secret key. Generate once and keep it safe:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# If you lose or change it, stores must re-enter their Paystack keys.
PAYSTACK_KEYS_ENCRYPTION_KEY=

# Where YOUR 1% commission is paid out. Bank or mobile-money code from
# Paystack's list (GET https://api.paystack.co/bank?currency=GHS), e.g. MTN
PLATFORM_PAYSTACK_SETTLEMENT_BANK=
# Account number (bank) or MoMo number, e.g. 0241234567
PLATFORM_PAYSTACK_ACCOUNT_NUMBER=
# Name shown on the commission subaccount in each store's Paystack (optional)
# PLATFORM_COMMISSION_NAME=Akwaaba Shops commission

# Optional: protects /api/cron/expire-orders (Vercel Cron sends it automatically)
# CRON_SECRET=
